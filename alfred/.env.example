# Copy to .env and fill in. Never commit .env.
ALFRED_ENV=development

# --- Required ---
# From @BotFather on Telegram
TELEGRAM_TOKEN=your_telegram_bot_token_here
# Your personal chat ID — Alfred ignores everyone else. Get it from @userinfobot
TELEGRAM_CHAT_ID=your_chat_id_here
# From console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Optional (defaults shown) ---
# ALFRED_MODEL=claude-sonnet-4-6
# ALFRED_HOME_LOCATION=Taupo, New Zealand
# ALFRED_VOICE_REPLIES=true
# WHISPER_MODEL=base

# Where alfred.db, chroma_db/, token.json live. Defaults to this folder.
# ALFRED_DATA_DIR=
# Where kokoro-v1_0.onnx and voices-v1_0.bin live. Defaults to this folder.
# ALFRED_MODELS_DIR=

# --- Banking via Akahu (optional, read-only) ---
# Free personal app: my.akahu.nz → connect banks, developers.akahu.nz → copy tokens
# AKAHU_APP_TOKEN=app_token_...
# AKAHU_USER_TOKEN=user_token_...

# --- Food ordering safety (Milestone 8) ---
# true = stop one click before "Place order". Set false only when you trust it.
# ALFRED_ORDER_DRY_RUN=true
# Refuse any order above this (NZD)
# ALFRED_ORDER_MAX_NZD=60
